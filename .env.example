# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_ACCESS_TOKEN: Server-side Meta WhatsApp Business Cloud API token (never expose to client/APK).
WHATSAPP_ACCESS_TOKEN=

# VITE_FIREBASE_VAPID_KEY: Optional Web Push VAPID key from Firebase Console > Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=

# PRIMARY_ADMIN_EMAIL / VITE_PRIMARY_ADMIN_EMAIL: Verified Google account email for the single primary Admin.
VITE_PRIMARY_ADMIN_EMAIL="MY_NEW_ADMIN_EMAIL"
PRIMARY_ADMIN_EMAIL="MY_NEW_ADMIN_EMAIL"
